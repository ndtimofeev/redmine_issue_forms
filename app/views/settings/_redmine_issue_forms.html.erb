<%# Plugin settings (Administration -> Plugins -> Configure). The blank
    hidden value makes unchecking every tracker save an empty list instead
    of keeping the old one; RedmineIssueForms.tracker_ids drops it. %>
<% selected = RedmineIssueForms.tracker_ids %>
<% unless RedmineIssueForms.textile? %>
  <%# With another text formatting the plugin does nothing at all (see
      RedmineIssueForms::SUPPORTED_TEXT_FORMATTING); say so where the
      forms are set up, rather than leave people wondering. %>
  <div class="flash warning"><%= l(:text_issue_forms_not_textile, formatting: Setting.text_formatting.presence || '-') %></div>
<% end %>
<p>
  <label><%= l(:label_issue_forms_trackers) %></label>
  <%= hidden_field_tag 'settings[tracker_ids][]', '', id: nil %>
  <% Tracker.sorted.each do |tracker| %>
    <label class="block">
      <%= check_box_tag 'settings[tracker_ids][]', tracker.id, selected.include?(tracker.id.to_s), id: "settings_tracker_ids_#{tracker.id}" %>
      <%= tracker.name %>
    </label>
  <% end %>
  <em class="info"><%= l(:text_issue_forms_settings_hint) %></em>
</p>
